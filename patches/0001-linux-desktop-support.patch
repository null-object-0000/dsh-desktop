+
+  async toBuffer(options?: { readonly resolveWithObject?: boolean }): Promise<unknown> {
+    const reply = await this.bridge.request('run', this.state.input, this.state.options, this.state.operations, options)
+    if (!reply.ok || reply.data === undefined) throw new Error(reply.error ?? 'image worker: encoding failed')
+    const data = Buffer.from(reply.data, 'base64')
+    return options?.resolveWithObject === true ? { data, info: reply.info ?? {} } : data
+  }
+}
+
+/** Rebuild sharp-shaped metadata from the worker's buffer-free projection. */
+function restoreMetadata(projection: Record<string, unknown>): Record<string, unknown> {
+  const present = (value: unknown): Buffer | undefined => value === true ? Buffer.alloc(0) : undefined
+  return {
+    ...projection,
+    exif: present(projection.hasExif),
+    xmp: present(projection.hasXmp),
+    iptc: present(projection.hasIptc),
+    icc: present(projection.hasIcc),
+    tifftagPhotoshop: present(projection.hasTifftagPhotoshop),
+    comments: present(projection.hasComments),
+  }
+}
+
+/** Worker program: one JSON line in, one JSON line out; the only place sharp decodes. */
+const BRIDGE_WORKER_SOURCE = [
+  "'use strict'",
+  "const sharp = require(process.argv[2])",
+  "const readline = require('node:readline')",
+  "const send = payload => process.stdout.write(JSON.stringify(payload) + '\\n')",
+  "const OPS = new Set(['rotate', 'toColourspace', 'resize', 'raw', 'webp', 'jpeg', 'png'])",
+  "const reduced = metadata => ({ format: metadata.format, width: metadata.width, height: metadata.height,",
+  "  pages: metadata.pages, orientation: metadata.orientation, depth: metadata.depth, space: metadata.space,",
+  "  hasAlpha: metadata.hasAlpha, hasExif: metadata.exif !== undefined, hasXmp: metadata.xmp !== undefined,",
+  "  hasIptc: metadata.iptc !== undefined, hasIcc: metadata.icc !== undefined, hasProfile: metadata.hasProfile === true,",
+  "  hasTifftagPhotoshop: metadata.tifftagPhotoshop !== undefined, hasComments: metadata.comments !== undefined })",
+  "async function run(message) {",
+  "  let image = sharp(Buffer.from(message.input, 'base64'), message.options || {})",
+  "  for (const operation of message.operations || []) {",
+  "    if (!OPS.has(operation.name)) throw new Error('image worker: unsupported sharp operation ' + operation.name)",
+  "    image = image[operation.name](...operation.args)",
+  "  }",
+  "  if (message.kind === 'metadata') return { metadata: reduced(await image.metadata()) }",
+  "  if (message.toBuffer && message.toBuffer.resolveWithObject === true) {",
+  "    const encoded = await image.toBuffer({ resolveWithObject: true })",
+  "    return { data: encoded.data.toString('base64'), info: encoded.info }",
+  "  }",
+  "  return { data: (await image.toBuffer()).toString('base64') }",
+  "}",
+  "readline.createInterface({ input: process.stdin, terminal: false }).on('line', line => {",
+  "  let message",
+  "  try { message = JSON.parse(line) } catch { return }",
+  "  run(message).then(result => send({ id: message.id, ok: true, ...result }),",
+  "    error => send({ id: message.id, ok: false, error: error && error.message ? error.message : String(error) }))",
+  "})",
+].join('\n')
+
+/** Load Sharp: bridged to a standalone decoder on Electron, in-process elsewhere. */
+export function requireSharp(): typeof sharp {
+  return createSharp()
+}
