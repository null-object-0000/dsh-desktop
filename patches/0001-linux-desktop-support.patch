+/** Render the standard hicolor icon set electron-builder needs on Linux.
+ *
+ * Upstream ships only `resources/icon.png` at its designer size (1104x1104).
+ * electron-builder copies that single file into a matching `1104x1104` icon
+ * directory, which no freedesktop icon theme searches, so installed desktop
+ * entries fall back to a generic placeholder. Rasterizing the master icon into
+ * the standard size directories fixes the launcher and store icons.
+ *
+ * usage: node scripts/linux/render-linux-icons.mjs
+ */
+import { mkdirSync, rmSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const repositoryRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..')
+const desktopRoot = join(repositoryRoot, 'apps', 'desktop')
+const source = join(desktopRoot, 'resources', 'icon.png')
+const output = join(desktopRoot, 'resources', 'icon-linux')
+
+const SIZES = [16, 24, 32, 48, 64, 128, 256, 512]
+// The hicolor theme also looks up @2 variants on HiDPI screens; electron-builder
+// names each output directory after the file's real pixel size, so render those
+// separately for the sizes that benefit from it.
+const SIZES_2X = [32, 48, 64, 128, 256, 512, 1024]
+
+const require = createRequire(join(desktopRoot, 'package.json'))
+const sharp = require('sharp')
+
+rmSync(output, { recursive: true, force: true })
+mkdirSync(output, { recursive: true })
+
+const targets = [...new Set([...SIZES, ...SIZES_2X])].sort((left, right) => left - right)
+for (const size of targets) {
+  const file = join(output, `${size}x${size}.png`)
+  await sharp(source)
+    .resize(size, size, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
+    .png({ compressionLevel: 9 })
+    .toFile(file)
+}
+console.log(`rendered ${targets.length} linux icons into ${output}`)
+
+// StatusNotifier hosts draw a single bitmap and scale it themselves, so ship one
+// crisp 32px PNG rather than an ICO; the desktop shell picks the display density.
+const tray = join(desktopRoot, 'resources', 'tray-linux.png')
+await sharp(source)
+  .resize(32, 32, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
+  .png({ compressionLevel: 9 })
+  .toFile(tray)
+console.log(`rendered linux tray icon into ${tray}`)
